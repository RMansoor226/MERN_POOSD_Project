# Copy this file to .env and fill in the values. Never commit .env.

# Connection string for MongoDB (the host "mongodb" is the Docker Compose service name)
MONGODB_URI=mongodb://mongodb:27017/AppDB

# Port for the Node API server
PORT=5000

# Authorization Secrets
JWT_SECRET=<generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:3000
AUTH_RATE_LIMIT=20
